{
  "name": "dsh-hot-routes",
  "version": "1.0.1",
  "description": "Hot-refresh the allowed subagent model routes of running Sessions on settings save (no restart, no new Session). / 保存子智能体模型设置后，正在运行的会话立即热刷新可用路由。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/q2560080107/dsh-hot-routes.git"
  },
  "author": "风花雪月",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "subagent",
    "model-routing",
    "hot-reload",
    "hot-refresh",
    "model-selection",
    "agent",
    "session",
    "llm",
    "路由热刷新",
    "子智能体"
  ],
  "files": [
    "index.js",
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "INSTALL.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
